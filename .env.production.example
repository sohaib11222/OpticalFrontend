# Copy to .env.production.local on the deployment host.
# Domain-root deployment: /. Subdirectory deployment: /pulse-ui/.
# This controls both built assets and the React router; rebuild after changes.
VITE_APP_BASE_PATH=/

# API requests remain same-origin /api and /sanctum. The production web server
# must route them to Laravel. Vite's development proxy is not a production proxy.
